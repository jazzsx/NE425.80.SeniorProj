# This file documents the environment variables the app reads. It is
# safe to commit because it contains no real values.
#
# To use it: copy this file to ".env" (which .gitignore already
# excludes from version control) and fill in real values, OR export
# these as real environment variables on the server (for example, in
# a systemd service's EnvironmentFile). This project does not
# auto-load ".env" files -- you still need to export these yourself
# before running the app, e.g. with `export $(cat .env | xargs)`.

# Active Directory domain and domain controller. Defaults already
# match this project's environment, so these only need to be set if
# you're pointing at a different domain.
AD_DOMAIN=seniorproj25.local
AD_SERVER_HOST=dc01.seniorproj25.local
AD_LDAPS_PORT=636

# Path to the CA bundle used to validate the domain controller's TLS
# certificate. Defaults to Ubuntu's system trust store.
LDAP_CA_CERTS_FILE=/etc/ssl/certs/ca-certificates.crt

# Random value Flask uses to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Required in production; if unset, a temporary one is generated for
# you automatically (fine for local testing, not for real use).
SECRET_KEY=

# PostgreSQL connection settings. PostgreSQL runs locally on the same
# Ubuntu server as the Flask app. Defaults already match this
# project's database name and application role, so DB_HOST/PORT/NAME/
# USER usually don't need to be set -- but DB_PASSWORD always does;
# there is no default password, on purpose.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ir_playbook_db
DB_USER=ir_playbook_app
DB_PASSWORD=

# Optional: fully overrides all of the DB_* variables above with one
# connection string, if you'd rather set it that way (or need to
# point at a non-PostgreSQL database, e.g. for testing).
# Example: postgresql+psycopg2://ir_playbook_app:secret@localhost:5432/ir_playbook_db
DATABASE_URL=
