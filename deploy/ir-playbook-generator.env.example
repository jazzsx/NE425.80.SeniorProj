# Production environment file template for the Incident Response
# Playbook Generator, consumed by systemd via the unit's
# EnvironmentFile= directive (see deploy/systemd/ir-playbook-generator.service).
#
# This is a TEMPLATE with placeholder values only -- it is safe to
# commit. The REAL file goes at /etc/ir-playbook-generator/ir-playbook-generator.env
# on the Ubuntu server, is created manually (never committed to Git),
# and must be locked down to root and the service account only. See
# the README's Stage 6 section for the exact commands to create it
# without ever typing secrets into your shell history.
#
# Format notes for systemd's EnvironmentFile=:
#   - Plain KEY=VALUE lines, one per line.
#   - No "export" keyword (that's a shell-ism; systemd doesn't use a shell to read this file).
#   - No quotes needed around values unless the value itself contains whitespace.
#   - Lines starting with # are comments and are ignored.

# --- Flask session signing key ---
# Generate a real one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_REAL_RANDOM_VALUE

# --- Active Directory / LDAPS ---
# Defaults in app/config.py already match this project's lab domain;
# only set these if your deployment differs.
AD_DOMAIN=seniorproj25.local
AD_SERVER_HOST=dc01.seniorproj25.local
AD_LDAPS_PORT=636
LDAP_CA_CERTS_FILE=/etc/ssl/certs/ca-certificates.crt

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ir_playbook_db
DB_USER=ir_playbook_app
DB_PASSWORD=REPLACE_WITH_THE_REAL_ir_playbook_app_ROLE_PASSWORD

# --- Anthropic Claude API ---
ANTHROPIC_API_KEY=REPLACE_WITH_A_REAL_ANTHROPIC_API_KEY
ANTHROPIC_MODEL=claude-sonnet-5

# --- Cookie security ---
# Leave "false" until Nginx is confirmed serving real HTTPS (see
# deploy/nginx/ir-playbook-generator.conf), then switch to "true" and
# restart the service. See the README for why order matters here.
SESSION_COOKIE_SECURE=false
